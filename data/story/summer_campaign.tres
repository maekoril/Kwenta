[resource]
script = ExtResource("1_script")
product_catalog = Array[Resource]([ExtResource("2_noodles"), ExtResource("3_drink"), ExtResource("4_chips"), ExtResource("5_biscuits"), ExtResource("6_water"), ExtResource("7_candy"), ExtResource("8_coffee"), ExtResource("9_sardines"), ExtResource("10_laundry"), ExtResource("14_shampoo"), ExtResource("15_toothpaste"), ExtResource("16_juice"), ExtResource("17_tea"), ExtResource("18_bread"), ExtResource("19_eggs"), ExtResource("20_soy"), ExtResource("21_vinegar"), ExtResource("22_fish"), ExtResource("23_oil"), ExtResource("24_rice")])
store_upgrades = Array[Resource]([ExtResource("25_rail"), ExtResource("26_cooler"), ExtResource("27_shelf"), ExtResource("28_condiments"), ExtResource("29_crates")])
day_order_pools = Array[Resource]([ExtResource("11_day1"), ExtResource("12_day4"), ExtResource("13_day7")])
order_pool_start_days = Array[int]([1, 4, 7])
customer_ids = Array[String]( ["aleng_mila", "kuya_ben", "ate_liza", "jun", "manong_tomas", "nina"] )
initial_cash = 150
shift_length_seconds = 480.0
customer_spawn_interval = 18.0
customer_patience_seconds = 55.0
trust_loss_on_timeout = 25.0
shelf_replacement_goal = 1500
trusted_regular_goal = 3
trusted_regular_minimum = 80.0
story_intro = "Your report card is still on the kitchen table: missed classes, unfinished work, and grades you could have improved. This summer, your parents put you in charge of the family sari-sari store. They want the worn shelves replaced before school starts. You think it sounds like an easy punishment—until the first customer arrives."
story_transition_texts = Array[String](["The first shift was longer than you expected. Tomorrow, you decide, you'll be faster.", "Aleng Mila comes back. She remembers your name—and the snack her grandson likes.", "More neighbors arrive at once. You start learning where everything belongs.", "A rush feels different when several neighbors need you at once. You begin to understand how much patience and trust matter.", "Your parents ask what you learned, not just what you earned. You think about how your choices affect neighbors who rely on the store.", "You prepare the shelves before opening. The work is starting to feel like yours.", "A busy afternoon tests everything you've practiced. Your regulars are counting on you.", "You notice the store is more than a way to earn money; neighbors depend on it.", "The last day of summer is almost here. You look at the shelves—and at how far you've come.", "The new school year is close. Your family gathers to see what you built this summer."])
ending_balanced_success = "The new shelves are ready, and the regulars still trust the store. You haven't solved everything at school, but you understand that showing up—for your work, your learning, and other people—is a choice you can keep making."
ending_mixed_progress = "Some of the summer goal is still unfinished, but you can see what your effort changed: in the store, in your relationships, and in yourself. Your family makes a plan to keep going together as school begins."
ending_hopeful_second_chance = "The shelves still need work and some neighbors stopped coming, but the summer wasn't wasted. You learned what your choices can cost—and that you can take responsibility, rebuild trust, and keep trying when school starts."

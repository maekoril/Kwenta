extends SceneTree
func _initialize() -> void:
	call_deferred("run")
func run() -> void:
	var main = load("res://scenes/main.tscn").instantiate()
	root.add_child(main)
	await process_frame
	main.story.write_diary_entry(1)
	main.story.write_diary_entry(2)
	main.pause_menu.set_available(true)
	main.pause_menu.pause()
	var reader = main.pause_menu.diary_reader
	reader.open(main.story)
	reader._flip(-1)
	assert(reader.page_turn.visible and reader.page_turn.direction == -1)
	await create_timer(0.18).timeout
	assert(reader.page_turn.progress > 0.0 and reader.page_turn.progress < 1.0)
	reader._flip(1)
	assert(reader.page_turn.direction == 1 and reader.page_index == 1)
	await create_timer(0.7).timeout
	assert(not reader.page_turn.visible and reader.heading.text.contains("DAY 2"))
	reader._flip(1)
	assert(not reader.page_turn.visible)
	reader._flip(-1)
	reader.close()
	assert(not reader.page_turn.visible)
	reader.open(main.story)
	reader._select_section(2)
	reader._select_day(4)
	assert(reader.page_turn.visible)
	reader._flip(1)
	assert(reader.page_turn.visible and reader.medal_day == 5)
	reader._select_day(4)
	assert(reader.gallery.entries.size() > 1)
	reader.gallery.thumbnails.get_child(1).pressed.emit()
	assert(reader.gallery.selected == 1 and not reader.page_turn.visible)
	assert(reader.previous_button.text == "←" and reader.next_button.text == "→")
	await create_timer(0.75).timeout
	assert(not reader.page_turn.visible)
	reader._select_section(1)
	reader.collection_buttons[1].pressed.emit()
	assert(reader.medal_day == 2 and not reader.page_turn.visible)
	reader._flip(1)
	assert(reader.medal_day == 3 and not reader.page_turn.visible)
	reader._select_day(4)
	assert(reader.medal_day == 4 and not reader.page_turn.visible)
	reader.close()
	main.pause_menu.resume()
	main.queue_free()
	print("Notebook page turns animate while paused, handle rapid reversal, bounds and close")
	quit()
